QWidget {
    background-color: #f4f4f4;
    font-family: "Segoe UI", Arial;
    font-size: 13px;
}

QLabel {
    color: #222222;
    font-weight: bold;
}

QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    padding-left: 5px;
}

QDoubleSpinBox:read-only {
    background-color: #e6e6e6;
    color: #333333;
}

QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #999999;
    border-radius: 6px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #d5d5d5;
}

QPushButton#start_btn {
    color: green;
}

QPushButton#start_btn:checked {
    color: red;
}

QFrame#bridge {
    background-color: #9e9e9e;
    border: none;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    padding-left: 8px;
}