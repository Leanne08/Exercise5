QWidget {
    background-color: #eef2f6;
    font-family: "Segoe UI", Arial;
    font-size: 13px;
    color: #1e293b;
}

QLabel {
    color: #334155;
    font-weight: bold;
    background-color: transparent;
}

QLabel[text=""] {
    background-color: #94a3b8;
    border-radius: 4px;
}

QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding-left: 8px;
    color: #0f172a;
    font-weight: bold;
}

QDoubleSpinBox:focus {
    border: 2px solid #3b82f6;
}

QDoubleSpinBox:read-only {
    background-color: #e2e8f0;
    color: #475569;
    border: 1px solid #cbd5e1;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-weight: bold;
    font-size: 14px;
    color: #1e293b;
}

QPushButton:hover {
    background-color: #f8fafc;
    border: 1px solid #94a3b8;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton:checkable {
    background-color: #dcfce7;
    border: 1px solid #86efac;
    color: #166534;
}

QPushButton:checkable:hover {
    background-color: #bbf7d0;
}

QPushButton:checked {
    background-color: #fee2e2;
    border: 1px solid #fca5a5;
    color: #991b1b;
}

QPushButton:checked:hover {
    background-color: #fecaca;
}

QSlider::groove:vertical {
    background: #cbd5e1;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #3b82f6;
    border: 2px solid #ffffff;
    height: 16px;
    width: 16px;
    margin: 0 -6px;
    border-radius: 9px;
}

QSlider::handle:vertical:hover {
    background: #2563eb;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding-left: 10px;
    font-weight: bold;
    color: #1e293b;
}

QComboBox:hover {
    border: 1px solid #94a3b8;
}